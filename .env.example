# Askwell configuration.
#
#   cp .env.example .env    then set POSTGRES_PASSWORD
#
# .env is gitignored and must stay that way: a committed connection string is a
# breach, not a bug (C8). This file holds names and safe defaults only — never
# a real value.
#
# Every variable Askwell reads is prefixed ASKWELL_. An unknown ASKWELL_*
# variable stops the application from starting rather than being ignored, so a
# typo here surfaces immediately instead of leaving the setting it was meant to
# change silently on its default.
#
# M0-FOUND-SEC-007 completes this file and adds the discipline that keeps it
# current. What is here is what the Compose stack needs today.

# --- Database (Compose only) ------------------------------------------------
# These three are read by Compose and by the Postgres image, NOT by Askwell.
# They deliberately do not carry the ASKWELL_ prefix: every ASKWELL_* variable
# is an application setting, and an unknown one stops the application from
# starting. Sharing the prefix with Compose-only variables would mean either
# weakening that check or maintaining an exception list — and the check's whole
# value is that it needs neither.
#
# The password is required with no default: it carries a credential, so there
# is no honest default. Any value works, because the database is not reachable
# from outside the stack, but it must be set deliberately rather than shipped.
# The owner. Runs migrations; the application never connects as this.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=askwell
POSTGRES_DB=askwell

# The application role. Askwell connects as this and it owns nothing —
# a table owner bypasses its own grants, so if the application connected as
# the owner, the audit log's append-only guarantee would look correct and do
# nothing at all (C6).
POSTGRES_APP_PASSWORD=change-me-too

# Read-only, independent of the application role. Model-generated SQL is
# parsed and rejected by sqlglot AND executed as a role that cannot write,
# because one check is not a guarantee (C2). Used from M4.
POSTGRES_READONLY_PASSWORD=change-me-as-well

# --- Application ------------------------------------------------------------
# development: fail loudly, exception text reaches the client, human-readable
#              logs. production: degrade with a stated reason, JSON logs.
ASKWELL_ENVIRONMENT=development

# Which models the deployment profile selects. Model names never appear in
# application code.
#   light     ~8 GB machines. Slow but usable — see issue #49, unverified.
#   balanced  the default.
#   full      a workstation with a large GPU.
ASKWELL_PROFILE=balanced

ASKWELL_LOG_LEVEL=INFO

# The host port the interface is served on. It binds to 127.0.0.1 only.
ASKWELL_PORT=8000
