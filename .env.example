# Askwell configuration.
#
#   cp .env.example .env    then set the three passwords
#
# .env is gitignored and must stay that way: a committed connection string is a
# breach, not a bug (C8). This file holds names, descriptions and safe
# placeholders only — never a real value.
#
# **Every variable listed here is checked by a test.** A variable the
# application reads, or that compose.yaml references, and that is missing from
# this file fails `scripts/dev.sh test`. That is the point of the file: an
# example that drifts is worse than none, because it is read as authoritative.
#
# Two prefixes, and the difference is load-bearing:
#
#   ASKWELL_*    read by the application. An unknown one stops it from
#                starting rather than being ignored, so a typo surfaces
#                immediately instead of leaving a setting on its default.
#   POSTGRES_*   read by Compose and by the Postgres image, never by Askwell.
#                They deliberately do not carry the ASKWELL_ prefix — sharing
#                it would mean either weakening that check or maintaining an
#                exception list.


# ---------------------------------------------------------------------------
# Database — Compose and the Postgres image only
# ---------------------------------------------------------------------------

# The owner. Runs migrations. The application never connects as this.
POSTGRES_USER=askwell
POSTGRES_DB=askwell

# Required, no default: it carries a credential, so there is no honest default.
# Any value works — the database is not published outside the stack — but it
# must be set deliberately rather than shipped.
POSTGRES_PASSWORD=change-me

# The application role's password — a credential, like the one above. Askwell
# connects as this role and it owns nothing: a table owner bypasses its own
# grants, so if the application connected as the owner the audit log's
# append-only guarantee would look correct and do nothing at all (C6).
# See docs/decisions.md.
POSTGRES_APP_PASSWORD=change-me-too

# Read-only, independent of the application role. Model-generated SQL is parsed
# and rejected by sqlglot AND executed as a role that cannot write, because one
# check is not a guarantee (C2). Unused until M4.
POSTGRES_READONLY_PASSWORD=change-me-as-well


# ---------------------------------------------------------------------------
# Sandbox — a separate Postgres instance for untrusted dumps (C3)
# ---------------------------------------------------------------------------
# `docs/data-sources.md` §3: a `.sql` dump is a program. This instance is
# where one is loaded, never Askwell's own database, and it has no route to
# the egress proxy or the internet.

# The sandbox instance's own superuser — a different credential from
# POSTGRES_USER above, on a different Postgres instance. Used only by
# `askwell.sandbox`'s control plane (create and drop a per-source database);
# never by anything that runs a dump's own content.
SANDBOX_POSTGRES_USER=askwell_sandbox

# A credential, like POSTGRES_PASSWORD above. Any value works — the sandbox is
# not reachable outside the stack — but it must be set deliberately.
SANDBOX_POSTGRES_PASSWORD=change-me-in-the-sandbox-too

# The two fixed roles `deploy/sandbox/10-roles.sh` creates inside the sandbox
# instance. `askwell_sandbox_owner` is who dump content runs as while
# loading; `askwell_sandbox_readonly` is the query path once loaded. Neither
# can create a database, a role, or connect to a database it was not
# explicitly granted CONNECT on.
SANDBOX_OWNER_PASSWORD=change-me-sandbox-owner
SANDBOX_READONLY_PASSWORD=change-me-sandbox-readonly


# ---------------------------------------------------------------------------
# The application
# ---------------------------------------------------------------------------

# Required. The full connection string, as the application role rather than the
# owner. Compose builds this from the values above; set it directly only if you
# are running the API outside the stack.
ASKWELL_DATABASE_URL=postgresql://askwell_app:change-me-too@postgres:5432/askwell

# Required. The sandbox instance's superuser connection, to its own `postgres`
# maintenance database — a different instance, a different credential, from
# ASKWELL_DATABASE_URL above. Compose builds this from the SANDBOX_POSTGRES_*
# values above; set it directly only if you are running the API outside the
# stack.
ASKWELL_SANDBOX_DATABASE_URL=postgresql://askwell_sandbox:change-me-in-the-sandbox-too@sandbox:5432/postgres

# Required. `askwell_sandbox_owner`'s own password (M4-DUMP-ING-088) — the
# role a dump's content actually runs as while loading (C3), never the
# superuser above. Compose builds this from SANDBOX_OWNER_PASSWORD above; set
# it directly only if you are running the worker outside the stack.
ASKWELL_SANDBOX_OWNER_PASSWORD=change-me-sandbox-owner

# Required. `askwell_sandbox_readonly`'s own password (M4-SCHEMA-ING-100) —
# schema introspection against a sandbox database runs as this role, never
# the owner above. Compose builds this from SANDBOX_READONLY_PASSWORD above;
# set it directly only if you are running the API or worker outside the stack.
ASKWELL_SANDBOX_READONLY_PASSWORD=change-me-sandbox-readonly

# development: fail loudly, exception text reaches the client, human-readable
#              logs.
# production:  degrade with a stated reason, JSON logs.
ASKWELL_ENVIRONMENT=development

# Which models the deployment profile selects. Model names never appear in
# application code.
#   light     ~8 GB machines. Slow but usable — see issue #49, unverified.
#   balanced  the default.
#   full      a workstation with a large GPU.
ASKWELL_PROFILE=balanced

ASKWELL_LOG_LEVEL=INFO

# Loopback, and not a preference: 0.0.0.0 would put every document you have
# ever added onto whatever network you happen to be on. Inside the Compose
# stack the API listens on 0.0.0.0 and the *published port* binds to loopback
# instead — same guarantee, one layer out.
ASKWELL_HOST=127.0.0.1
ASKWELL_PORT=8000

# Where the built interface lives. A path, not a secret: it appears in logs
# unredacted, which is the point — "the interface has not been built" is
# useless without saying where it looked.
ASKWELL_WEB_ASSETS_DIR=/app/web/out


# ---------------------------------------------------------------------------
# The folders Askwell may read
# ---------------------------------------------------------------------------

# Askwell reads your files where they are and never copies them, so the
# containers need a route to the folders you nominate — one narrow route, not
# open filesystem access.
#
# This is that route: **one** directory on your machine, bind-mounted read-only
# into the API and the worker at the same absolute path it has on the host.
# Every folder you nominate in the interface must be inside it. Nominating a
# folder outside it still works — Askwell records it and tells you to widen
# this and run `podman compose up -d` again, because a container's mounts
# cannot be changed while it is running on any platform Askwell supports.
#
# Set it to the narrowest directory that contains your material:
#
#   ASKWELL_ROOTS_MOUNT=/home/you/clients
#
# Empty means Askwell has no window onto your filesystem yet. That is the
# correct state on a fresh install, and the interface says so plainly rather
# than failing later somewhere that will not mention a mount. Compose reads
# this; so does Askwell, to know what it can see.
ASKWELL_ROOTS_MOUNT=


# ---------------------------------------------------------------------------
# Components the health surface reports
# ---------------------------------------------------------------------------

# Compose service names. Changing these means changing compose.yaml too.
ASKWELL_REDIS_HOST=redis
ASKWELL_REDIS_PORT=6379

# The worker is not addressed by host and port: it consumes a queue and listens
# on nothing, so a TCP probe would report a healthy worker as down. It
# publishes a health record into Redis under this key instead.
ASKWELL_WORKER_HEALTH_KEY=arq:queue:health-check

# Inference runs natively on the host — GPU acceleration only works from there
# on all three platforms — and the containers reach it over a Unix socket
# rather than the network. Every service is on a network with no route off the
# machine (C1), so there is no address to dial; a socket file on a bind mount
# needs no route at all. See docs/decisions.md.
#
# Inside a container this is the mount point; on the host, `scripts/dev.sh
# inference` points it at ./.run instead.
ASKWELL_INFERENCE_SOCKET=/run/askwell/inference.sock

# The host directory holding that socket, bind-mounted into the API and worker.
# Compose reads this; Askwell never does.
ASKWELL_RUN_DIR=./.run

# The host directory holding the voice container's three model files —
# Whisper `small` (a directory), Silero VAD (.onnx) and Kokoro-82M (.onnx +
# .bin) — bind-mounted read-only into it at /models. Defaults to the same
# directory the host-side inference supervisor reads its own models from
# (ASKWELL_INFERENCE_MODEL_PATH and friends, above), since it is one place on
# disk for "the models" either way. Also mounted read-only into the API at
# /models (M7-SET-FE-146), where Settings -> Model and speed lists the model
# files placed here as swap candidates; compose sets the API's own
# ASKWELL_MODELS_DIR to /models and passes this host value through as
# ASKWELL_MODELS_DIR_DISPLAY, so neither needs setting here.
ASKWELL_MODELS_DIR=~/.local/share/askwell/models

# How Settings names the models folder when telling you where to place a
# model file. Left empty, compose fills it from ASKWELL_MODELS_DIR above — the
# folder as you know it on this machine, not the API's /models view of it.
ASKWELL_MODELS_DIR_DISPLAY=

# 32 random bytes, generated on first use, that a stored connection credential
# is encrypted with (C8, M4-CONN-SEC-098). Lives on the same host-backed mount
# as the socket above — outside postgres-data, so a copy of that volume alone
# is not a credential leak. Losing this file locks every stored credential
# rather than exposing them; re-entry is the only way forward.
ASKWELL_INSTALL_SECRET_PATH=/run/askwell/install.key

# Where the host-side hardware probe (`deploy/probe/askwell-probe`,
# M7-PROBE-DEPLOY-137) writes its result. Same bind mount as the socket and
# the install key above, for the same reason: a container sees the cgroup's
# or the VM's view of memory, not the machine's, so the probe runs on the
# host and hands its result across this shared mount (docs/architecture.md §6).
ASKWELL_PROBE_RESULT_PATH=/run/askwell/probe.json

# Read by the host-side supervisor only. The containers never see these.
# No model name appears in application code: profiles select models
# (docs/architecture.md §6), and a name in code cannot change without a release.
ASKWELL_INFERENCE_BINARY=llama-server
ASKWELL_INFERENCE_CONTEXT_SIZE=8192

# Three roles, three processes, three models. One llama.cpp process cannot
# serve all three: --reranking needs a reranker model and is mutually
# exclusive with generation, and a generation model's embeddings are 2560
# dimensions where the schema is vector(1024) — so they would not merely be
# poor for retrieval, the database would refuse them. Measured, not assumed;
# see issue #89.
#
# The containers reach all three through the one socket above; the bridge
# routes by path. Only the host-side supervisor sees these ports.
ASKWELL_INFERENCE_MODEL_PATH=~/.local/share/askwell/models/Qwen3.5-4B-Q4_K_M.gguf
ASKWELL_INFERENCE_UPSTREAM_PORT=8080

# bge-m3, at 1024 dimensions to match chunks.embedding.
ASKWELL_EMBEDDING_MODEL_PATH=~/.local/share/askwell/models/bge-m3-FP16.gguf
ASKWELL_EMBEDDING_PORT=8081

# bge-reranker-v2-m3. It scores query-document pairs; it cannot generate, and
# the generation model cannot rank.
ASKWELL_RERANKER_MODEL_PATH=~/.local/share/askwell/models/bge-reranker-v2-m3-FP16.gguf
ASKWELL_RERANKER_PORT=8082

ASKWELL_EGRESS_PROXY_HOST=egress-proxy
ASKWELL_EGRESS_PROXY_PORT=3128

# The update check (`M7-UPDATE-BE-161`, C1). A static file, not an API
# endpoint — this repository's own VERSION file, served as a plain blob by
# raw.githubusercontent.com. Reached at all only when the stored answer is
# "yes"; see docs/decisions.md, 2026-09-21.
ASKWELL_UPDATE_FEED_HOST=raw.githubusercontent.com
ASKWELL_UPDATE_FEED_URL=https://raw.githubusercontent.com/Rumeasiyan/askwell/main/VERSION
ASKWELL_UPDATE_CHECK_POLL_SECONDS=3600
ASKWELL_UPDATE_CHECK_INTERVAL_SECONDS=604800

# The voice container's three models, all CPU, all local files
# (`api/src/askwell/voice/catalog.py` names the source and licence of each).
# These are container-side paths — ASKWELL_MODELS_DIR above is what maps a
# host directory onto /models; changing these means the files inside that
# directory are named differently, not that the container looks elsewhere.
ASKWELL_VOICE_WHISPER_MODEL_PATH=/models/whisper-small
ASKWELL_VOICE_VAD_MODEL_PATH=/models/silero_vad.onnx
ASKWELL_VOICE_KOKORO_MODEL_PATH=/models/kokoro-v1.0.onnx
ASKWELL_VOICE_KOKORO_VOICES_PATH=/models/voices-v1.0.bin
# Which Kokoro-82M voice preset speaks answers (`M6-TTS-BE-130`) — not a
# model, so not gated by the model-registry rule, but still never hardcoded
# past this one setting.
ASKWELL_VOICE_KOKORO_VOICE=af_heart
ASKWELL_VOICE_HOST=0.0.0.0
ASKWELL_VOICE_PORT=8090
# Backpressure bound for the voice WebSocket channel (`M6-AUDIO-API-126`) —
# audio chunks queued on either side before the other end is made to wait.
ASKWELL_VOICE_AUDIO_QUEUE_SIZE=32
# Where `api` dials the `voice` container for transcription (`M6-STT-BE-127`).
ASKWELL_VOICE_SERVICE_HOST=voice
# How long a pause has to run, after speech was heard, before a voice turn
# closes on its own (`M6-STT-BE-128`) — an unmeasured starting point, see
# `api/src/askwell/config.py`'s own comment on this setting.
ASKWELL_VOICE_VAD_PAUSE_MS=700
# Below this, a transcribed turn is held for confirmation rather than
# answered directly (`M6-STT-FE-129`) — an unmeasured starting point, see
# `api/src/askwell/config.py`'s own comment on this setting.
ASKWELL_STT_CONFIRMATION_CONFIDENCE_THRESHOLD=0.6
# How long a held turn waits for `confirm`/`edit` before giving up on its
# own — the user walked away without confirming (`M6-STT-FE-129`).
ASKWELL_STT_CONFIRMATION_TIMEOUT_SECONDS=120.0

# A ceiling per probe, not for the whole surface: health has to answer even
# when every component is down, which is exactly when someone is looking at it.
ASKWELL_HEALTH_PROBE_TIMEOUT_SECONDS=1.0

# How long the connection wizard waits for a live database to answer,
# `M4-CONN-FE-096`. Short: it is a request the user is watching, not a
# background import.
ASKWELL_CONNECTION_PROBE_TIMEOUT_SECONDS=5.0

# How long a generated query may run before Postgres cancels it, `M4-SQL-DB-107`.
# Raise it if a legitimate aggregate over a large database needs more time.
ASKWELL_SQL_STATEMENT_TIMEOUT_SECONDS=30

# How long sqlglot may spend parsing one generated query before it is
# rejected, `M4-SQL-VAL-104`. Bounds the parser, not the database.
ASKWELL_SQL_VALIDATION_TIMEOUT_SECONDS=2.0

# The row cap added to a validated query with no aggregate and no limit of
# its own, `M4-SQL-VAL-105`. Raise it if 1000 rows is too few to work with.
ASKWELL_SQL_ROW_LIMIT=1000

# Which web search provider implementation `M6.5-WEB-BE-185` builds behind.
# Empty means no provider is configured: the escalation is offered as
# unavailable rather than crashing. `fixture` returns recorded results, for
# development and the eval suite. `ddgs` (`M6.5-WEB-BE-195`) is the real,
# keyless provider — set this to reach it.
ASKWELL_WEB_SEARCH_PROVIDER=

# How long one escalation's provider call may run before it is abandoned and
# the turn reports the provider unreachable.
ASKWELL_WEB_SEARCH_TIMEOUT_SECONDS=10.0

# The one destination the egress proxy grant `M6.5-WEB-SEC-187` opens for one
# turn's escalation — `ddgs`'s `duckduckgo` backend, the only one
# `M6.5-WEB-BE-195` uses, so a single destination is enough.
ASKWELL_WEB_SEARCH_DESTINATION_HOST=html.duckduckgo.com
ASKWELL_WEB_SEARCH_DESTINATION_PORT=443

# How long a turn's egress grant may stand before it expires on its own, even
# if the turn never tells the proxy it is done. `M6.5-WEB-SEC-187`'s hard
# expiry — the backstop for a missed closing path, not the normal case.
ASKWELL_WEB_SEARCH_GRANT_TTL_SECONDS=30.0

# `askwell.webfetch.fetch_pages`'s three caps, `M6.5-WEB-BE-188`. First
# guesses, tuned with real use — a change here is a decision, not a drift.
# How many of a provider's results are ever fetched.
ASKWELL_WEB_FETCH_MAX_RESULTS=3
# A page over this many bytes is dropped whole, never truncated.
ASKWELL_WEB_FETCH_MAX_BYTES=500000
# Per-page fetch timeout, distinct from ASKWELL_WEB_SEARCH_TIMEOUT_SECONDS
# (the whole provider call, search included).
ASKWELL_WEB_FETCH_TIMEOUT_SECONDS=5.0

# How many documents are indexed at once. Two, because this laptop is also
# running the browser and the answer the user is waiting for — extraction and
# embedding take every core they are given. Raise it on a workstation.
ASKWELL_INGEST_CONCURRENCY=2

# How many chunks go into one call to the embedding model. Bounded so a large
# document does not send hundreds of passages to the model in one call and
# stall everything else the machine is doing.
ASKWELL_EMBEDDING_BATCH_SIZE=16

# How long one document may spend in the pipeline before the worker gives up on
# it. An hour: OCR over a 900-page scan on CPU is genuinely that slow, and a
# timeout shorter than the work turns a slow file into a failed one.
ASKWELL_INGEST_JOB_TIMEOUT_SECONDS=3600

# How often the worker re-dispatches queued work the queue has forgotten. This
# is what recovers an import from a flushed Redis or a machine that woke up
# without its queue.
ASKWELL_INGEST_RECONCILE_SECONDS=30

# Below this, a document's OCR is flagged low confidence — still indexed,
# never a failure. Not a measured figure: raise or lower it for the scans a
# given install actually sees.
ASKWELL_OCR_CONFIDENCE_THRESHOLD=0.60

# How often the worker checks every indexed document's recorded path against
# disk, catching a moved or renamed file even when nobody has opened it yet.
ASKWELL_MISSING_CHECK_SECONDS=300

# How often the worker probes every ready/attention live connection,
# `M4-CONN-BE-099`. Metadata-only, never a query over the user's own data —
# what makes running it this often acceptable on somebody's laptop.
ASKWELL_CONNECTION_HEALTH_CHECK_SECONDS=60


# ---------------------------------------------------------------------------
# Retrieval and traces
# ---------------------------------------------------------------------------

# The embedding model's output dimension, and therefore the width of every
# embedding column. Configuration rather than a literal in the migration,
# because changing model is a configuration change plus a re-embed rather than
# a schema edit. bge-m3 gives 1024.
ASKWELL_EMBEDDING_DIMENSIONS=1024

# How many candidates dense search and lexical search each fetch before
# reciprocal rank fusion. The fused result is truncated to the same count.
ASKWELL_RETRIEVAL_CANDIDATE_COUNT=40

# The score below which a candidate is a near-miss rather than a match. Not
# applied yet — abstaining on it is M2 — but captured with every candidate's
# score so the trace can show the near-miss without recomputing it later.
ASKWELL_RETRIEVAL_SCORE_THRESHOLD=0.65

# How many of the fused candidates go through the cross-encoder reranker.
# Bounded separately from ASKWELL_RETRIEVAL_CANDIDATE_COUNT to keep reranking
# latency inside budget on a light profile.
ASKWELL_RERANK_CANDIDATE_COUNT=10

# How long the reranker gets before its result is discarded in favour of
# fusion order. A slow rerank degrades to a still-useful answer instead of
# making the user wait twice for the same passages.
ASKWELL_RERANK_TIMEOUT_SECONDS=10.0

# The ceiling on one answer's own length, in tokens. Streamed regardless, and
# never truncated silently — reaching this is stated to the user.
ASKWELL_GENERATION_MAX_TOKENS=1024

# Appended to every composed prompt so a reasoning model writes the answer
# instead of thinking first: an already-closed, empty `<think>` block, so the
# model's next token is the answer. The delimiters belong to the model, not to
# Askwell, which is why this lives here rather than in the code. Empty sends
# nothing. Note the literal newlines — this is a prefill, not a flag.
ASKWELL_GENERATION_THINKING_DIRECTIVE="\n\n<think>\n\n</think>\n\n"

# How many answers may generate at once, bounded so several abandoned
# questions running at once do not make the laptop unusable.
ASKWELL_GENERATION_MAX_CONCURRENT=2

# Traces are the largest and fastest-growing of the three audit stores, and the
# only one that fails open. Losing one costs nothing visible: citations are a
# real table and do not rotate.
ASKWELL_TRACE_DIR=/var/lib/askwell/traces
ASKWELL_TRACE_MAX_BYTES=268435456

# Where a log export (`M7-LOG-BE-155`) is assembled and served from. Same
# `askwell-state` volume as ASKWELL_TRACE_DIR, so `api` and `worker` — separate
# containers — see the same files.
ASKWELL_EXPORT_DIR=/var/lib/askwell/exports

# Where a backup (`M7-BACKUP-BE-157`) is assembled and served from. Same
# `askwell-state` volume as ASKWELL_TRACE_DIR/ASKWELL_EXPORT_DIR.
ASKWELL_BACKUP_DIR=/var/lib/askwell/backups

# The version this machine last started as (`M7-UPDATE-FE-162`), so the next
# start can record an applied upgrade. A file on the `askwell-state` volume,
# never a database row — see issue #697.
ASKWELL_RUNNING_VERSION_PATH=/var/lib/askwell/running_version

# Where a local crash report (`M7-OPS-DOC-165`) is written. Same `askwell-state`
# volume, so the API lists what the worker wrote. Never sent anywhere: a report
# leaves this machine only if the person downloads it and attaches it themselves.
ASKWELL_CRASH_REPORT_DIR=/var/lib/askwell/crash-reports
