#!/usr/bin/env python3
"""Askwell's inference supervisor. Runs on the host, natively.

Three things forced this to be a standalone, dependency-free script rather than
part of the `askwell` package, and each was discovered by trying the other way.

**GPU acceleration only works from the host** on all three platforms, which is
why llama.cpp is native rather than containerised.

**A containerised API cannot start a host process.** `M0-MODEL-DEPLOY-018` said
the API would supervise this; it cannot, so supervision lives here.

**The host's Python is not ours to choose.** This machine runs 3.14 and the
package pins 3.12; a user's machine will be something else again. So this
imports nothing but the standard library and runs on whatever is there. That
is not a workaround — a host-side component that dictates the host's Python
version is a component that does not install.

It does **not** own the Unix socket the containers reach inference through, and
that was the second surprise. SELinux refuses `connectto` when a `container_t`
process dials a socket listened on by an `unconfined_t` one — the file label is
irrelevant, it is the *listener's process* label that decides. So the socket is
owned by a tiny bridge container instead, and this script only supervises the
model. See `docs/decisions.md`.

Configuration comes from the environment, with the same ASKWELL_ names the
application uses.
"""

from __future__ import annotations

import asyncio
import contextlib
import hashlib
import json
import os
import shutil
import threading
import signal
import sys
import time
import urllib.request
from pathlib import Path

# States the API reads back out of state.json. Kept in step with
# askwell.inference.state.ProcessState, and a test asserts they have not
# drifted — this file cannot import that one, so the check has to be explicit.
STARTING = "starting"
READY = "ready"
MODEL_MISSING = "model_missing"
LOAD_FAILED = "load_failed"
CRASHED = "crashed"
UNAVAILABLE = "unavailable"
STOPPED = "stopped"

# How often the supervisor rewrites its state while running. Without this, a
# state file says `ready` forever after the supervisor is killed — and the API
# would confidently report an assistant that is not there, which is the worst
# thing this surface can do.
HEARTBEAT_SECONDS = 10

# Backoff between restarts, then it stops. Restarting forever turns one problem
# into a log nobody reads and a machine that never settles, and by then the
# reason is more useful to the user than another attempt would be.
BACKOFF_SECONDS = (1, 2, 5, 15, 30)
READY_TIMEOUT_SECONDS = 300

# Three supervisors write one state file. Without this they read-modify-write
# over each other and a role's entry vanishes — which the API would read as
# that role having never reported.
STATE_LOCK = threading.Lock()


def env(name: str, default: str) -> str:
    return os.environ.get(name, default)


# The three roles, and what makes each one different.
#
# One process cannot serve all three, which was measured rather than assumed
# (issue #89). `--reranking` needs a reranker model and is mutually exclusive
# with generation. And a generation model's embeddings are 2560 dimensions
# where the schema is vector(1024), so they would not merely be poor for
# retrieval — the database would refuse them.
#
# Each is (role, model env var, port env var, default port, extra flags).
ROLES = (
    ("generation", "ASKWELL_INFERENCE_MODEL_PATH", "ASKWELL_INFERENCE_UPSTREAM_PORT", "8080", ()),
    ("embedding", "ASKWELL_EMBEDDING_MODEL_PATH", "ASKWELL_EMBEDDING_PORT", "8081",
     ("--embeddings", "--pooling", "mean")),
    ("reranking", "ASKWELL_RERANKER_MODEL_PATH", "ASKWELL_RERANKER_PORT", "8082",
     ("--reranking",)),
)


class Supervisor:
    def __init__(
        self,
        role: str = "generation",
        model_var: str = "ASKWELL_INFERENCE_MODEL_PATH",
        port_var: str = "ASKWELL_INFERENCE_UPSTREAM_PORT",
        default_port: str = "8080",
        extra_flags: tuple[str, ...] = (),
    ) -> None:
        self.role = role
        self.extra_flags = extra_flags
        self.binary = env("ASKWELL_INFERENCE_BINARY", "llama-server")
        self.model = Path(env(model_var, "")).expanduser()
        self.upstream_port = int(env(port_var, default_port))
        self.context_size = int(env("ASKWELL_INFERENCE_CONTEXT_SIZE", "8192"))
        self.socket_path = Path(env("ASKWELL_INFERENCE_SOCKET", "/run/askwell/inference.sock"))
        self.state_path = self.socket_path.parent / "state.json"

        self.process: asyncio.subprocess.Process | None = None

        # Two counters, because they answer different questions. `restarts` is
        # cumulative and is what the user is shown: "this has restarted eleven
        # times today" is a fact worth knowing. `consecutive` drives the
        # backoff and resets on a successful start, and showing it instead
        # would report 0 for a process that has been flapping all morning.
        self.restarts = 0
        self.consecutive = 0
        self.acceleration = "cpu"
        self._write(STOPPED)

    # --- what the API reads -------------------------------------------------

    def _write(self, state: str, reason: str | None = None) -> None:
        """Publish this role's state where the API can read it.

        A file rather than an endpoint, because the API cannot reach this
        process except through the socket, and the socket belongs to
        llama.cpp's HTTP rather than to the supervisor.

        The file holds one entry per role plus a top-level view of generation,
        which is what "the assistant" means to a user: they cannot ask a
        question without it, and retrieval failing is a different sentence.
        Written to a temporary file and moved, so a reader never sees half of
        it — and read-modify-written under a lock, because three supervisors
        share it.
        """
        mine = {
            "state": state,
            "model": self.model.name if self.model.name else None,
            "acceleration": self.acceleration if state == READY else None,
            "reason": reason,
            "restarts": self.restarts,
            "consecutive_failures": self.consecutive,
            "updated_at": time.time(),
        }

        with STATE_LOCK:
            try:
                existing = json.loads(self.state_path.read_text(encoding="utf-8"))
                roles = existing.get("roles", {}) if isinstance(existing, dict) else {}
            except (OSError, json.JSONDecodeError):
                roles = {}

            roles[self.role] = mine
            # Generation is promoted to the top level so that every reader
            # written against the single-process shape keeps working, and so
            # `askwell.inference.state.read` has one obvious thing to read.
            payload = dict(roles.get("generation", mine))
            payload["roles"] = roles

            try:
                self.state_path.parent.mkdir(parents=True, exist_ok=True)
                temporary = self.state_path.with_suffix(".partial")
                temporary.write_text(json.dumps(payload), encoding="utf-8")
                os.replace(temporary, self.state_path)
                os.chmod(self.state_path, 0o644)
            except OSError as error:
                print(f"askwell-inference: could not write state: {error}", file=sys.stderr)

        print(
            f"askwell-inference[{self.role}]: {state}" + (f" — {reason}" if reason else ""),
            flush=True,
        )

    # --- the process --------------------------------------------------------

    def command(self) -> list[str]:
        """No model name is written here.

        Profiles select models (docs/architecture.md §6). A name in code is a
        name that cannot change without a release.
        """
        return [
            self.binary,
            "--model", str(self.model),
            "--host", "127.0.0.1",
            "--port", str(self.upstream_port),
            "--ctx-size", str(self.context_size),
            "--no-webui",
            *self.extra_flags,
        ]

    async def start_once(self) -> bool:
        if not self.model.is_file():
            # Never a crash loop. Retrying cannot help: the file is not there,
            # and only the user can put it there.
            self._write(
                MODEL_MISSING,
                f"No model file at {self.model}. Askwell does not download "
                f"models. Put one there, or set ASKWELL_INFERENCE_MODEL_PATH.",
            )
            return False

        if shutil.which(self.binary) is None:
            self._write(
                UNAVAILABLE,
                f"{self.binary!r} is not on PATH. Askwell runs llama.cpp "
                f"natively so that GPU acceleration works; it is not bundled "
                f"in the container images.",
            )
            return False

        self._write(STARTING)
        self.process = await asyncio.create_subprocess_exec(
            *self.command(),
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
        )
        return True

    async def wait_until_ready(self) -> bool:
        """Ready means it answers, not that it said something.

        The first version watched stdout for a "server is listening" line and
        timed out after five minutes on a model that had in fact loaded in
        thirty seconds — llama.cpp block-buffers its output when stdout is a
        pipe rather than a terminal, so the line existed and had not arrived.

        Polling asks the only question that matters. The output is still read,
        in parallel, because it is where the useful failures explain
        themselves: "the model did not fit in memory" is something a user can
        act on, and "it never answered" is not.
        """
        process = self.process
        if process is None:
            return False

        recent: list[str] = []
        reader = asyncio.create_task(self._read_output(recent))
        try:
            async with asyncio.timeout(READY_TIMEOUT_SECONDS):
                while True:
                    if process.returncode is not None:
                        self._write(
                            LOAD_FAILED,
                            self._explain(recent)
                            or f"Exited with {process.returncode} while loading.",
                        )
                        return False
                    if await self._answers():
                        self._detect_acceleration(recent)
                        self._write(READY)
                        return True
                    await asyncio.sleep(0.5)
        except TimeoutError:
            self._write(
                LOAD_FAILED,
                self._explain(recent)
                or f"The model did not answer within {READY_TIMEOUT_SECONDS}s.",
            )
            return False
        finally:
            reader.cancel()
            with contextlib.suppress(asyncio.CancelledError):
                await reader

    async def _answers(self) -> bool:
        """One TCP connection: cheaper than an HTTP request, and at this stage
        it asks the same question — is it serving yet."""
        try:
            _, writer = await asyncio.open_connection("127.0.0.1", self.upstream_port)
        except OSError:
            return False
        writer.close()
        with contextlib.suppress(OSError):
            await writer.wait_closed()
        return True

    async def _read_output(self, recent: list[str]) -> None:
        """Keep the last lines, for explaining a failure."""
        process = self.process
        if process is None or process.stdout is None:
            return
        while True:
            raw = await process.stdout.readline()
            if not raw:
                return
            recent.append(raw.decode("utf-8", "replace").rstrip())
            del recent[:-200]

    @staticmethod
    def _explain(recent: list[str]) -> str | None:
        """The reason, from what the process said before it stopped."""
        for line in reversed(recent):
            lowered = line.lower()
            if "out of memory" in lowered or "failed to allocate" in lowered:
                return (
                    "The model did not fit in memory. This is memory, not a "
                    "crash — a smaller profile or a smaller quantisation will load."
                )
            if "failed to load model" in lowered or "error loading model" in lowered:
                return line
        return None

    def _detect_acceleration(self, recent: list[str]) -> None:
        for line in recent:
            lowered = line.lower()
            if ("offloading" in lowered and "layers to gpu" in lowered) or "cuda0" in lowered:
                self.acceleration = "gpu"
                return
        self.acceleration = "cpu"

    async def drain(self) -> None:
        """Keep reading while it runs.

        A process whose stdout buffer fills stops, silently, and looks like a
        hang rather than a mistake in the thing watching it.
        """
        process = self.process
        if process is None or process.stdout is None:
            return
        while await process.stdout.readline():
            pass

    async def supervise(self) -> None:
        while True:
            if not await self.start_once():
                return

            if await self.wait_until_ready():
                self.consecutive = 0
                heartbeat = asyncio.create_task(self._heartbeat())
                try:
                    await self.drain()
                finally:
                    heartbeat.cancel()
                    with contextlib.suppress(asyncio.CancelledError):
                        await heartbeat

            code = await self.process.wait() if self.process else None

            if self.consecutive >= len(BACKOFF_SECONDS):
                self._write(
                    UNAVAILABLE,
                    f"Stopped after {self.consecutive} restarts in a row; the last exit was "
                    f"{code}. Askwell is not retrying — by now the reason is "
                    f"more useful to you than another attempt.",
                )
                return

            delay = BACKOFF_SECONDS[self.consecutive]
            self.consecutive += 1
            self.restarts += 1
            self._write(CRASHED, f"Exited with {code}. Restarting in {delay}s.")
            await asyncio.sleep(delay)

    async def _heartbeat(self) -> None:
        """Keep saying `ready` while it is.

        The state file is otherwise only written on a transition, so a
        supervisor killed with SIGKILL — or a machine that lost power — would
        leave `ready` on disk indefinitely. The reader treats a stale file as
        stopped, and this is what keeps a live one from looking stale.
        """
        while True:
            await asyncio.sleep(HEARTBEAT_SECONDS)
            self._write(READY)

    async def stop(self) -> None:
        process = self.process
        if process is not None and process.returncode is None:
            process.send_signal(signal.SIGTERM)
            with contextlib.suppress(TimeoutError):
                async with asyncio.timeout(10):
                    await process.wait()
            if process.returncode is None:
                process.kill()
        self._write(STOPPED)


# --- fetching a model, on the host, because nothing in a container may ---------
#
# C1's egress proxy never forwards anything, and the application network is
# declared internal, so a container asking Hugging Face for a model gets a 403
# from the proxy — correctly. That is not a bug to work around: the proxy's
# whole safety property is that there is no configuration which would let it
# forward, and an allowlist would take that away for one feature.
#
# So the one download in the product happens here, for the same reason
# inference does: the host is where host things belong. The API writes a request
# into the models directory and reads progress back from it; it never opens a
# socket to anywhere. An air-gapped machine simply never writes a request and
# uses the manual-file path instead.
#
# stdlib only, like the rest of this file — the host has whatever Python it has.

FETCH_REQUEST = "fetch-request.json"
FETCH_PROGRESS = "fetch-progress.json"
FETCH_POLL_SECONDS = 1.0
FETCH_CHUNK = 1024 * 1024


def _fetch_write(models_dir: Path, payload: dict) -> None:
    """Publish progress the way `_write` publishes state: atomically."""
    target = models_dir / FETCH_PROGRESS
    try:
        models_dir.mkdir(parents=True, exist_ok=True)
        temporary = target.with_suffix(".partial")
        temporary.write_text(json.dumps(payload), encoding="utf-8")
        os.replace(temporary, target)
        os.chmod(target, 0o644)
    except OSError as error:
        print(f"askwell-inference[fetch]: could not write progress: {error}", file=sys.stderr)


def _fetch_once(models_dir: Path, request: dict) -> None:
    """One model, resumable, verified against the checksum the API sent.

    The checksum is not optional and is not computed here: it comes from the
    request, which the API took from a registry lookup. A file that arrives
    with the wrong bytes is deleted rather than kept, because a half-right model
    fails in ways that look like bad answers rather than like a bad download.
    """
    url = str(request["url"])
    filename = str(request["filename"])
    expected = str(request["sha256"])
    total = int(request["size_bytes"])
    target = models_dir / filename
    part = target.with_suffix(target.suffix + ".part")

    def publish(status: str, done: int, error: str | None = None) -> None:
        _fetch_write(models_dir, {
            "filename": filename,
            "status": status,
            "downloaded_bytes": done,
            "total_bytes": total,
            "error": error,
            "updated_at": time.time(),
        })

    if target.is_file() and target.stat().st_size == total:
        publish("ready", total)
        return

    done = part.stat().st_size if part.is_file() else 0
    if done > total:
        part.unlink()
        done = 0

    publish("downloading", done)
    request_headers = {"User-Agent": "askwell"}
    if done:
        request_headers["Range"] = f"bytes={done}-"

    try:
        req = urllib.request.Request(url, headers=request_headers)  # noqa: S310 - https, from the catalog
        with urllib.request.urlopen(req, timeout=30) as response:  # noqa: S310
            append = response.status == 206 and done > 0
            if not append:
                done = 0
            with open(part, "ab" if append else "wb") as handle:
                while True:
                    if (models_dir / "fetch-cancel").exists():
                        (models_dir / "fetch-cancel").unlink(missing_ok=True)
                        publish("paused", done)
                        return
                    chunk = response.read(FETCH_CHUNK)
                    if not chunk:
                        break
                    handle.write(chunk)
                    done += len(chunk)
                    publish("downloading", done)
    except Exception as error:  # noqa: BLE001 - a failed download is reported, never raised
        publish("failed", done, f"{type(error).__name__}: {error}. Nothing already downloaded was lost.")
        return

    digest = hashlib.sha256()
    with open(part, "rb") as handle:
        for block in iter(lambda: handle.read(FETCH_CHUNK), b""):
            digest.update(block)
    if digest.hexdigest() != expected:
        part.unlink(missing_ok=True)
        publish("failed", 0, "The downloaded file did not match its published checksum, so it was discarded.")
        return

    os.replace(part, target)
    publish("ready", total)


async def watch_for_fetch_requests(models_dir: Path, stopping: asyncio.Event) -> None:
    """Do what the API asked, when it asks, and nothing when it does not."""
    request_path = models_dir / FETCH_REQUEST
    while not stopping.is_set():
        try:
            if request_path.is_file():
                request = json.loads(request_path.read_text(encoding="utf-8"))
                request_path.unlink(missing_ok=True)
                await asyncio.to_thread(_fetch_once, models_dir, request)
        except (OSError, json.JSONDecodeError, KeyError, ValueError) as error:
            print(f"askwell-inference[fetch]: bad request: {error}", file=sys.stderr)
            request_path.unlink(missing_ok=True)
        with contextlib.suppress(asyncio.TimeoutError):
            await asyncio.wait_for(stopping.wait(), timeout=FETCH_POLL_SECONDS)


async def main() -> int:
    supervisors = [Supervisor(*role) for role in ROLES]

    # SIGTERM is how anything stops this: a service manager, a Ctrl-C'd
    # wrapper, `kill`. Python does not raise on it, so without this the
    # process dies before writing `stopped` — leaving a state file that says
    # `ready` and an API that believes it.
    stopping = asyncio.Event()
    loop = asyncio.get_running_loop()
    for received in (signal.SIGTERM, signal.SIGINT):
        with contextlib.suppress(NotImplementedError):
            loop.add_signal_handler(received, stopping.set)

    # Every role supervised independently. One model missing must not stop the
    # others: a user with no reranker can still ask questions, and telling them
    # the assistant is down because retrieval cannot rank would be false.
    running = [asyncio.create_task(s.supervise()) for s in supervisors]
    models_dir = Path(
        env("ASKWELL_MODELS_DIR", os.path.expanduser("~/.local/share/askwell/models"))
    )
    running.append(asyncio.create_task(watch_for_fetch_requests(models_dir, stopping)))
    waiting = asyncio.create_task(stopping.wait())

    try:
        await asyncio.wait([*running, waiting], return_when=asyncio.FIRST_COMPLETED)
        # One role finishing is not a reason to stop the others — a model that
        # is simply absent finishes immediately.
        if not stopping.is_set():
            await asyncio.wait([*running, waiting], return_when=asyncio.ALL_COMPLETED)
    finally:
        for task in (*running, waiting):
            task.cancel()
            with contextlib.suppress(asyncio.CancelledError):
                await task
        for supervisor in supervisors:
            await supervisor.stop()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(asyncio.run(main()))
    except KeyboardInterrupt:
        print("askwell-inference: stopped", flush=True)
