# Video generation is OFF by default (manual mode — composes a prompt, calls no API, costs
# nothing). Set VIDEO_GEN_PROVIDER to turn on a paid API for a specific project.
VIDEO_GEN_PROVIDER=manual
# VIDEO_GEN_PROVIDER=replicate
# VIDEO_GEN_PROVIDER=openrouter
# VIDEO_GEN_PROVIDER=atlascloud

REPLICATE_API_TOKEN=
OPENROUTER_API_KEY=
ATLASCLOUD_API_KEY=

# Image generation uses `codex exec` (scripts/imagegen.mjs) — no key needed here, it reuses
# your `codex login` session against your existing ChatGPT Plus subscription.
