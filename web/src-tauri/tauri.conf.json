{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Askwell",
  "version": "0.0.0",
  "identifier": "com.askwell.app",
  "build": {
    "frontendDist": "./shell-assets"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
