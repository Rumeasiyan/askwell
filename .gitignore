node_modules/
dist/
# Real environment files, in every shape people write them. Never the example.
.env
.env.*
!.env.example

# Generated credential material: keys, certificates, and anything a passphrase
# derives. None of this exists yet — the encryption arrives in M4 — and the
# ignore rule arriving first is deliberate. The alternative is adding it in the
# same commit that first writes one, which is the commit most likely to be in a
# hurry.
*.pem
*.key
*.p12
*.pfx
secrets/
*.log
.DS_Store
__pycache__/
*.py[cod]
.venv/

# build runner state — machine-local, full of session ids
.build-runner/

# Python toolchain caches — regenerated on every run
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Frontend build output and dependencies.
# .pnpm-store is pnpm's content-addressed package cache. It lands at the repo
# root because the container's working tree starts there, and it is a cache —
# keeping it means installs stay fast between runs, committing it would add
# tens of thousands of files.
.pnpm-store/
web/node_modules/
web/.next/
web/out/
next-env.d.ts
web/tsconfig.tsbuildinfo

# The host-side inference socket, bind-mounted into the containers
.run/
api/.venv-host/
